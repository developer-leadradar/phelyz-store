# ============================================================
# Phelyz Store - cPanel environment
#
# Copy this to  .env  in the site's document root and fill in the real values.
# NEVER commit the real .env - it is git-ignored and excluded from deployment
# by .cpanel.yml, so it stays put on the server across deploys.
# ============================================================

# ── Database (cPanel > MySQL Databases) ─────────────────────────────────────
# cPanel prefixes both with your account name, e.g. phelyz_store / phelyz_dbuser
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=CPANELUSER_phelyz
DB_USER=CPANELUSER_phelyz
DB_PASS=

# ── Site ────────────────────────────────────────────────────────────────────
SITE_NAME=Phelyz Store
SITE_URL=https://phelyzstore.com
SITE_EMAIL=support@phelyzstore.com
SITE_PHONE=+234 902 403 3207
SITE_WHATSAPP=+2349024033207
SITE_ADDRESS=Uyo, Akwa Ibom State, Nigeria

# ── Mail (cPanel > Email Accounts) ──────────────────────────────────────────
# Create support@phelyzstore.com first, then use its password here.
# Port 465 = ssl, port 587 = tls. mail.phelyzstore.com resolves once DNS lands.
SMTP_HOST=mail.phelyzstore.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=support@phelyzstore.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@phelyzstore.com
SMTP_FROM_NAME=Phelyz Store

# Leave empty - SMTP above is used instead. Only set if you switch to Resend.
RESEND_API_KEY=

# ── Paystack (dashboard.paystack.com > Settings > API Keys) ─────────────────
# Swap to the sk_live_/pk_live_ pair when you are ready to take real money.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── Image Studio (aistudio.google.com) ──────────────────────────────────────
GEMINI_API_KEY=

# ── Supabase: intentionally blank ───────────────────────────────────────────
# With these empty, uploadImage() writes to local uploads/ instead of Supabase
# Storage. Do not repopulate them, or new uploads will go back to Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=
